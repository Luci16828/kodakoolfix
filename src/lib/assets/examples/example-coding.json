{
  "source": "example/Greifenbote 22",
  "codes": [
    {
      "device": "9861c7d0-d592-4c2a-8e6f-ae8cd4fa854d",
      "line": 7,
      "range": [3, 14],
      "excerpt": "Greifenpass"
    },
    {
      "device": "fddad1ac-49b5-40a7-ad67-de5f14d8334c",
      "line": 8,
      "range": [4, 16],
      "excerpt": "Feuerflieger"
    },
    {
      "device": "f8b8e546-8873-4e7a-bd92-f29c65545151",
      "line": 8,
      "range": [67, 73],
      "excerpt": "Tunnel"
    },
    {
      "device": "bc147aba-0b4e-42fd-9066-23e920985f43",
      "line": 9,
      "range": [0, 5],
      "excerpt": "Asche"
    },
    {
      "device": "b3378cc5-739d-4d8c-b472-9c37e888cfe0",
      "line": 9,
      "range": [46, 51],
      "excerpt": "Gilde"
    },
    {
      "device": "2f99fdd1-a85d-4ed6-ad2b-c8870d89bea4",
      "line": 10,
      "range": [18, 21],
      "excerpt": "Rat"
    },
    {
      "device": "fc277976-99f3-4622-891e-b405fbae4a2e",
      "line": 10,
      "range": [55, 62],
      "excerpt": "Drachen"
    },
    {
      "device": "9861c7d0-d592-4c2a-8e6f-ae8cd4fa854d",
      "line": 14,
      "range": [62, 73],
      "excerpt": "Greifenpass"
    },
    {
      "device": "fc277976-99f3-4622-891e-b405fbae4a2e",
      "line": 15,
      "range": [32, 45],
      "excerpt": "junger Drache"
    },
    {
      "device": "bc147aba-0b4e-42fd-9066-23e920985f43",
      "line": 16,
      "range": [45, 55],
      "excerpt": "Aschewolke"
    },
    {
      "device": "0950cf9a-14b5-4e2f-83ba-d17afc32b3c4",
      "line": 17,
      "range": [6, 90],
      "excerpt": "Das ist kein Postverkehr mehr, das ist ein flammendes Ungeheuer über unseren Dächern"
    },
    {
      "device": "d8935b30-7b92-4aab-877d-7871b59c82a9",
      "line": 18,
      "range": [14, 62],
      "excerpt": "Seit die Feuerpost tiefer über die Dörfer fliegt",
      "note": "Tiefflug seit dem Tunnel-Einsturz"
    },
    {
      "device": "0950cf9a-14b5-4e2f-83ba-d17afc32b3c4",
      "line": 19,
      "range": [6, 25],
      "excerpt": "„brennenden Straße“"
    },
    {
      "device": "5b98a579-d5a4-4362-ab44-635e3b426ca8",
      "line": 19,
      "range": [36, 66],
      "excerpt": "Die Sturmglocke von Marderbach"
    },
    {
      "device": "bc147aba-0b4e-42fd-9066-23e920985f43",
      "line": 22,
      "range": [54, 71],
      "excerpt": "schwarzen Flecken"
    },
    {
      "device": "d8935b30-7b92-4aab-877d-7871b59c82a9",
      "line": 23,
      "range": [0, 43],
      "excerpt": "Drei Höfe haben binnen einer Woche gebrannt",
      "note": "Binnen einer Woche drei Höfe gebrannt"
    },
    {
      "device": "0950cf9a-14b5-4e2f-83ba-d17afc32b3c4",
      "line": 23,
      "range": [59, 80],
      "excerpt": "derselbe Feuerflieger"
    },
    {
      "device": "6b195667-ebe1-4eb6-9b59-b1a17d458d40",
      "line": 24,
      "range": [4, 32],
      "excerpt": "ungezähmter, unzuverlässiger"
    },
    {
      "device": "473a1728-7a07-4631-98ad-2d42a33e32b3",
      "line": 24,
      "endLine": 25,
      "range": [55, 9],
      "excerpt": "ohne erfahrenen Reiter auf die Strecke\ngeschickt",
      "note": "Unerfahrener Knappe allein auf der Strecke"
    },
    {
      "device": "b3378cc5-739d-4d8c-b472-9c37e888cfe0",
      "line": 25,
      "range": [11, 78],
      "excerpt": "Die Drachenreitergilde weiß um die Gefahr, aber sie redet sie klein",
      "note": "Gilde weiß, redet klein"
    },
    {
      "device": "2d2215bd-4a57-40d0-8900-5a0f52b9864b",
      "line": 27,
      "range": [0, 55],
      "excerpt": "Postmeisterin Elara Flugstolz weist die Vorwürfe zurück",
      "note": "Postmeisterin weist Vorwürfe zurück"
    },
    {
      "device": "f8fccc9b-9909-4284-96fc-d7e503376020",
      "line": 27,
      "range": [57, 79],
      "excerpt": "Seit elfhundert Jahren"
    },
    {
      "device": "fc277976-99f3-4622-891e-b405fbae4a2e",
      "line": 27,
      "range": [90, 101],
      "excerpt": "Drachenpost"
    },
    {
      "device": "9861c7d0-d592-4c2a-8e6f-ae8cd4fa854d",
      "line": 28,
      "range": [42, 53],
      "excerpt": "Greifenpass"
    },
    {
      "device": "f8fccc9b-9909-4284-96fc-d7e503376020",
      "line": 28,
      "range": [56, 92],
      "excerpt": "ehrwürdig, bewährt und unverzichtbar"
    },
    {
      "device": "50a15a5b-fa2d-4cf9-8595-656b8c841615",
      "line": 29,
      "range": [0, 66],
      "excerpt": "Wer die Feuerpost angreife, greife die heile Welt der Bergtäler an"
    },
    {
      "device": "5924d9fd-bf89-4494-878f-c337c2dd5c94",
      "line": 29,
      "endLine": 30,
      "range": [68, 22],
      "excerpt": "als wäre sie ein verklärtes\nGemälde aus alter Zeit"
    },
    {
      "device": "18f4fb4e-5ade-4c0c-9a0c-b3b1d5b89769",
      "line": 30,
      "range": [24, 86],
      "excerpt": "Zum Herbstdanktag hat die Gilde eine Drachenschule angekündigt",
      "note": "Drachenschule angekündigt"
    },
    {
      "device": "fddad1ac-49b5-40a7-ad67-de5f14d8334c",
      "line": 31,
      "range": [0, 12],
      "excerpt": "Feuerflieger"
    },
    {
      "device": "a49a98c3-edbd-447f-86ca-bc8ccb87fde4",
      "line": 31,
      "range": [16, 24],
      "excerpt": "tapferen"
    },
    {
      "device": "a083bbc0-d190-4529-a92d-1788a7bf4ea2",
      "line": 31,
      "endLine": 32,
      "range": [81, 18],
      "excerpt": "Kurzsichtigkeit\nin goldenen Ketten",
      "note": "Versprechen in goldenen Ketten"
    },
    {
      "device": "5b98a579-d5a4-4362-ab44-635e3b426ca8",
      "line": 34,
      "range": [7, 19],
      "excerpt": "Alten Glocke"
    },
    {
      "device": "9861c7d0-d592-4c2a-8e6f-ae8cd4fa854d",
      "line": 34,
      "range": [31, 44],
      "excerpt": "Greifenpasses"
    },
    {
      "device": "a49a98c3-edbd-447f-86ca-bc8ccb87fde4",
      "line": 34,
      "range": [71, 93],
      "excerpt": "die Mutigsten des Tals"
    },
    {
      "device": "5924d9fd-bf89-4494-878f-c337c2dd5c94",
      "line": 35,
      "range": [4, 28],
      "excerpt": "Helden des Drachenspiels"
    },
    {
      "device": "d043c516-6e42-4940-924a-e2fdca3399f3",
      "line": 35,
      "endLine": 36,
      "range": [30, 43],
      "excerpt": "Jeden Aschmondtag strömen Schaulustige aus den Märkten herbei,\num die Landung der Feuerflieger zu bejubeln",
      "note": "Schaulustige strömen zum Pass"
    },
    {
      "device": "58cfe9fa-f91b-4d5b-8fe8-7011f281f052",
      "line": 36,
      "endLine": 37,
      "range": [66, 33],
      "excerpt": "verdient am Spektakel und will\ndas Ende des Tieffugs nicht hören",
      "note": "Krüge verdienen am Tiefflug"
    },
    {
      "device": "d043c516-6e42-4940-924a-e2fdca3399f3",
      "line": 37,
      "range": [35, 92],
      "excerpt": "Die Schaulust der Fremden treibe die Reiter erst recht an"
    },
    {
      "device": "5924d9fd-bf89-4494-878f-c337c2dd5c94",
      "line": 38,
      "range": [0, 69],
      "excerpt": "und wer zuhöre, halte den Pass für ein Fest statt für eine Brandstatt"
    },
    {
      "device": "2f99fdd1-a85d-4ed6-ad2b-c8870d89bea4",
      "line": 40,
      "range": [33, 85],
      "excerpt": "Der Rat selbst hält sich seit Wochen aus der Debatte",
      "note": "Der Rat schweigt"
    },
    {
      "device": "1a30cd7b-a85e-4099-ab12-efb077b419ec",
      "line": 40,
      "endLine": 41,
      "range": [87, 77],
      "excerpt": "Runenwartin\nIlva Tiefgraben: Der Einsturz des Tunnels sei Nachlässigkeit, nicht Schicksal",
      "note": "Runenwartin: Tunnelursache"
    },
    {
      "device": "c4d775f1-71e0-4f7d-9ebd-3b25003521b1",
      "line": 41,
      "endLine": 42,
      "range": [92, 34],
      "excerpt": "den\nBau der Runenfaserlinie Regenbogen",
      "note": "Runenfaserlinie Regenbogen"
    },
    {
      "device": "a0b84152-0abf-4c4e-ab04-d34437d3178c",
      "line": 42,
      "range": [36, 66],
      "excerpt": "ein Faserkabel aus Spinnenglas"
    },
    {
      "device": "a283b452-67b3-4ebf-944e-ec27129aa801",
      "line": 42,
      "endLine": 43,
      "range": [90, 13],
      "excerpt": "ohne\nRauch und Ruß"
    },
    {
      "device": "9861c7d0-d592-4c2a-8e6f-ae8cd4fa854d",
      "line": 43,
      "range": [23, 27],
      "excerpt": "Pass"
    },
    {
      "device": "c4d775f1-71e0-4f7d-9ebd-3b25003521b1",
      "line": 43,
      "range": [35, 87],
      "excerpt": "Der Regenbogen sei billiger als jeder Schadensersatz"
    },
    {
      "device": "4ddc0b8f-a91d-4c15-8ac6-b5677a215313",
      "line": 43,
      "endLine": 44,
      "range": [89, 23],
      "excerpt": "Die\nDrachenpost von gestern"
    },
    {
      "device": "7761902f-26f1-453e-a382-663064527e16",
      "line": 44,
      "range": [37, 87],
      "excerpt": "der Gilde, die an jedem Flügelschlag Gold verdient",
      "note": "Gilde verdient am Flügelschlag"
    },
    {
      "device": "a2258bf6-1cce-47fe-b1a9-fe8ff7353558",
      "line": 44,
      "endLine": 46,
      "range": [89, 26],
      "excerpt": "Unerhört[...]während\ndie Höfe ihre Asche zählen",
      "note": "Brandschatzliste ohne Branthalm"
    },
    {
      "device": "f8b8e546-8873-4e7a-bd92-f29c65545151",
      "line": 48,
      "range": [56, 80],
      "excerpt": "Der Einsturz des Tunnels"
    },
    {
      "device": "2a0cc824-dea2-4b92-b36f-3be3da2feacf",
      "line": 49,
      "range": [10, 62],
      "excerpt": "seitdem habe niemand die Flugkorridore neu vermessen",
      "note": "Niemand vermaß die Korridore neu"
    },
    {
      "device": "c6a5fbce-ff05-4710-a889-d7a553d55c24",
      "line": 49,
      "endLine": 50,
      "range": [64, 26],
      "excerpt": "Die Korridore stammen aus Karten\nvon vor zweihundert Jahren",
      "note": "Korridore von vor zweihundert Jahren"
    },
    {
      "device": "6bb168e1-3429-41a6-93eb-bfe7b52400d1",
      "line": 50,
      "endLine": 51,
      "range": [28, 24],
      "excerpt": "Weil die Post billige Fahrten verspricht, nimmt die Gilde unbändige\nJünglinge in die Pflicht",
      "note": "Billige Postfahrten mit Jünglingen"
    },
    {
      "device": "6b195667-ebe1-4eb6-9b59-b1a17d458d40",
      "line": 51,
      "range": [27, 96],
      "excerpt": "wild und unberechenbar würden die Tiere, wenn sie früh allein fliegen"
    },
    {
      "device": "d8935b30-7b92-4aab-877d-7871b59c82a9",
      "line": 52,
      "range": [19, 81],
      "excerpt": "vier von fünf Bränden gingen auf unbegleitete Jungtiere zurück",
      "note": "Vier von fünf Bränden: Jungtiere"
    },
    {
      "device": "cfd87aa7-f33f-46d5-b1bb-c78987b626f4",
      "line": 52,
      "endLine": 53,
      "range": [83, 61],
      "excerpt": "Die Schulmeister\nlehren die Knappen alles über Berge, aber nichts über Drachen",
      "note": "Schulmeister ohne Drachenkunde"
    },
    {
      "device": "2f99fdd1-a85d-4ed6-ad2b-c8870d89bea4",
      "line": 55,
      "range": [0, 85],
      "excerpt": "Der Rat hat seit Jahrzehnten keine Feuerstraße und keine Wasserleitung am Pass gebaut",
      "note": "Keine Feuerstraße, keine Wasserleitung"
    },
    {
      "device": "aed5d068-088e-4dff-bd26-cf74191359c6",
      "line": 55,
      "endLine": 56,
      "range": [87, 38],
      "excerpt": "die Bergwacht\nist unterbesetzt, ihre Türme verfallen",
      "note": "Bergwacht unterbesetzt"
    },
    {
      "device": "85983784-5ff0-4df5-bac6-15f00f50ed49",
      "line": 56,
      "endLine": 57,
      "range": [40, 15],
      "excerpt": "die Kartographenzunft malt seit Menschengedenken dieselben\nfalschen Karten",
      "note": "Kartographenzunft malt falsche Karten"
    },
    {
      "device": "58cfe9fa-f91b-4d5b-8fe8-7011f281f052",
      "line": 57,
      "range": [17, 57],
      "excerpt": "die Krüge am Pass verdienen am Spektakel",
      "note": "Krüge verdienen am Spektakel"
    },
    {
      "device": "b49bc47b-cb09-4f02-af41-bc10a36dfbd2",
      "line": 57,
      "endLine": 58,
      "range": [68, 38],
      "excerpt": "mancher Hof wurde mutwillig\nmitten im alten Flugkorridor errichtet",
      "note": "Hof im alten Flugkorridor"
    },
    {
      "device": "a083bbc0-d190-4529-a92d-1788a7bf4ea2",
      "line": 58,
      "range": [41, 52],
      "excerpt": "kurzsichtig",
      "note": "Bauen im Flugkorridor"
    },
    {
      "device": "0950cf9a-14b5-4e2f-83ba-d17afc32b3c4",
      "line": 58,
      "range": [54, 82],
      "excerpt": "im Schatten der Feuerflieger",
      "note": "Im Schatten der Feuerflieger"
    },
    {
      "device": "36c79e66-7542-45b1-8cf6-6239ac0d7338",
      "line": 60,
      "range": [4, 8],
      "excerpt": "Gold"
    },
    {
      "device": "7761902f-26f1-453e-a382-663064527e16",
      "line": 60,
      "endLine": 61,
      "range": [38, 8],
      "excerpt": "Für die Gilde wiege das Zollgold schwerer als die Asche\nder Höfe",
      "note": "Zollgold vor Asche"
    },
    {
      "device": "10b9d731-c440-4877-b721-095174acb6be",
      "line": 61,
      "range": [10, 61],
      "excerpt": "gierig nennen die Bauern die Pächter der Flugrechte",
      "note": "Pächter der Flugrechte"
    },
    {
      "device": "a2258bf6-1cce-47fe-b1a9-fe8ff7353558",
      "line": 61,
      "endLine": 62,
      "range": [63, 36],
      "excerpt": "unerhört, daß die Flugrechte meist\nan auswärtige Häuser verpachtet sind",
      "note": "Flugrechte auswärtiger Häuser"
    },
    {
      "device": "b1367a07-3e93-43f4-8f4f-0f75716768de",
      "line": 62,
      "range": [38, 94],
      "excerpt": "Die Kammer verlangt einen Schadensausgleich für die Höfe",
      "note": "Schadensausgleich gefordert"
    },
    {
      "device": "2f99fdd1-a85d-4ed6-ad2b-c8870d89bea4",
      "line": 63,
      "range": [0, 45],
      "excerpt": "und der Rat vertrage die Forderung mit Geduld",
      "note": "Der Rat vertröstet"
    },
    {
      "device": "642f9b91-cbf1-40f8-b672-c8c5c89d7187",
      "line": 65,
      "range": [0, 36],
      "excerpt": "Ein Nachtflugverbot für Feuerflieger",
      "note": "Nachtflugverbot"
    },
    {
      "device": "642f9b91-cbf1-40f8-b672-c8c5c89d7187",
      "line": 65,
      "endLine": 66,
      "range": [38, 3],
      "excerpt": "der Vorschlag der Feuerwacht liegt seit dem Vorjahr im\nRat"
    },
    {
      "device": "2f99fdd1-a85d-4ed6-ad2b-c8870d89bea4",
      "line": 66,
      "range": [5, 33],
      "excerpt": "wird nicht einmal aufgerufen",
      "note": "Nachtflugverbot nicht aufgerufen"
    },
    {
      "device": "18f4fb4e-5ade-4c0c-9a0c-b3b1d5b89769",
      "line": 66,
      "range": [35, 93],
      "excerpt": "Zähmung statt Eile: die Forderung nach einer Drachenschule"
    },
    {
      "device": "c4d775f1-71e0-4f7d-9ebd-3b25003521b1",
      "line": 67,
      "range": [0, 51],
      "excerpt": "Faser statt Federn: der Regenbogen in jeder Debatte"
    },
    {
      "device": "b1367a07-3e93-43f4-8f4f-0f75716768de",
      "line": 67,
      "range": [53, 78],
      "excerpt": "Ausgleich statt Aussitzen"
    },
    {
      "device": "d8935b30-7b92-4aab-877d-7871b59c82a9",
      "line": 67,
      "endLine": 68,
      "range": [81, 50],
      "excerpt": "die Vorschläge\nliegen alle auf dem Tisch, keiner wird beschlossen",
      "note": "Alle Vorschläge, kein Beschluß"
    },
    {
      "device": "3258a4ae-179b-49f0-a8da-eccbf571d847",
      "line": 70,
      "range": [8, 13],
      "excerpt": "Angst"
    },
    {
      "device": "3258a4ae-179b-49f0-a8da-eccbf571d847",
      "line": 70,
      "range": [15, 85],
      "excerpt": "Mythen[...]überblenden die Tatsachen",
      "note": "Mythen überblenden die Tatsachen"
    },
    {
      "device": "3258a4ae-179b-49f0-a8da-eccbf571d847",
      "line": 70,
      "endLine": 71,
      "range": [87, 53],
      "excerpt": "kein Drache\nverbrenne einen Menschen aus Bosheit, sagen die Alten",
      "note": "Mythos vom bösen Drachen"
    },
    {
      "device": "3258a4ae-179b-49f0-a8da-eccbf571d847",
      "line": 71,
      "endLine": 72,
      "range": [55, 9],
      "excerpt": "und doch zähle man im Tal bald mehr Asche\nals Ernte",
      "note": "Mehr Asche als Ernte"
    },
    {
      "device": "0950cf9a-14b5-4e2f-83ba-d17afc32b3c4",
      "line": 72,
      "range": [11, 20],
      "excerpt": "Bedrohung"
    },
    {
      "device": "fddad1ac-49b5-40a7-ad67-de5f14d8334c",
      "line": 72,
      "range": [42, 54],
      "excerpt": "Feuerflieger"
    },
    {
      "device": "5924d9fd-bf89-4494-878f-c337c2dd5c94",
      "line": 72,
      "range": [56, 65],
      "excerpt": "Sehnsucht"
    },
    {
      "device": "47b85cf4-ef56-4b22-a624-916fcde85835",
      "line": 74,
      "range": [0, 75],
      "excerpt": "Nur der alte Postmeister steht abseits und rechnet in einer anderen Währung",
      "note": "Der Postmeister rechnet anders"
    },
    {
      "device": "47b85cf4-ef56-4b22-a624-916fcde85835",
      "line": 74,
      "endLine": 75,
      "range": [77, 38],
      "excerpt": "Sein Handwerk, sagt\ner, habe aus Asche und Treue bestanden",
      "note": "Asche und Treue"
    },
    {
      "device": "47b85cf4-ef56-4b22-a624-916fcde85835",
      "line": 75,
      "range": [40, 55],
      "excerpt": "Sentimentalität"
    },
    {
      "device": "a283b452-67b3-4ebf-944e-ec27129aa801",
      "line": 75,
      "range": [83, 92],
      "excerpt": "Weitsicht"
    },
    {
      "device": "4ddc0b8f-a91d-4c15-8ac6-b5677a215313",
      "line": 76,
      "range": [28, 65],
      "excerpt": "rückständig nennen ihn beide den Pass",
      "note": "Der Pass: rückständig"
    },
    {
      "device": "36c79e66-7542-45b1-8cf6-6239ac0d7338",
      "line": 78,
      "range": [12, 80],
      "excerpt": "wandert Gold für Wechsel und Zoll durch die Hallen des Greifenpasses",
      "note": "Gold für Wechsel und Zoll"
    },
    {
      "device": "fc277976-99f3-4622-891e-b405fbae4a2e",
      "line": 78,
      "endLine": 79,
      "range": [82, 32],
      "excerpt": "die Drachen\nder Post setzen Fracht um Fracht"
    },
    {
      "device": "fddad1ac-49b5-40a7-ad67-de5f14d8334c",
      "line": 79,
      "range": [35, 66],
      "excerpt": "Feuerflieger über Feuerfliegern"
    },
    {
      "device": "b3378cc5-739d-4d8c-b472-9c37e888cfe0",
      "line": 79,
      "endLine": 80,
      "range": [68, 27],
      "excerpt": "die Gilde zählt die Sätze\nund schweigt über die Asche",
      "note": "Gilde zählt, schweigt"
    },
    {
      "device": "10b9d731-c440-4877-b721-095174acb6be",
      "line": 80,
      "range": [29, 36],
      "excerpt": "Habgier"
    },
    {
      "device": "f8fccc9b-9909-4284-96fc-d7e503376020",
      "line": 80,
      "range": [38, 47],
      "excerpt": "Ehrenwert"
    },
    {
      "device": "d8935b30-7b92-4aab-877d-7871b59c82a9",
      "line": 82,
      "range": [29, 82],
      "excerpt": "ihren Hof zweimal in einem einzigen Aschmond verloren",
      "note": "Hof zweimal im selben Monat"
    },
    {
      "device": "a2258bf6-1cce-47fe-b1a9-fe8ff7353558",
      "line": 82,
      "range": [84, 92],
      "excerpt": "Unerhört"
    },
    {
      "device": "2f99fdd1-a85d-4ed6-ad2b-c8870d89bea4",
      "line": 83,
      "range": [0, 43],
      "excerpt": "der Rat habe ihr keinen Branthalm bewilligt",
      "note": "Kein Branthalm für die Witwe"
    },
    {
      "device": "2d2215bd-4a57-40d0-8900-5a0f52b9864b",
      "line": 83,
      "range": [45, 91],
      "excerpt": "die Postmeisterin schicke ihr ein Trostgedicht",
      "note": "Postmeisterin: Trostgedicht"
    },
    {
      "device": "47b85cf4-ef56-4b22-a624-916fcde85835",
      "line": 84,
      "range": [0, 7],
      "excerpt": "Rührend"
    },
    {
      "device": "a2258bf6-1cce-47fe-b1a9-fe8ff7353558",
      "line": 84,
      "range": [9, 17],
      "excerpt": "unerhört"
    },
    {
      "device": "a49a98c3-edbd-447f-86ca-bc8ccb87fde4",
      "line": 86,
      "range": [18, 96],
      "excerpt": "verteidigen die Post mit Leib und Leben und gelten als die Tapfersten des Tals",
      "note": "Knappen verteidigen die Post"
    },
    {
      "device": "d043c516-6e42-4940-924a-e2fdca3399f3",
      "line": 87,
      "range": [0, 80],
      "excerpt": "und jeder von ihnen träumt davon, eines Tages der Held des Drachenspiels zu sein",
      "note": "Träumende Knappen"
    },
    {
      "device": "b3378cc5-739d-4d8c-b472-9c37e888cfe0",
      "line": 87,
      "endLine": 88,
      "range": [82, 38],
      "excerpt": "Die Gilde lobe\nihren Mut, wo sie Aufsicht üben könnte",
      "note": "Gilde lobt statt beaufsichtigt"
    },
    {
      "device": "6bb168e1-3429-41a6-93eb-bfe7b52400d1",
      "line": 88,
      "range": [40, 82],
      "excerpt": "denn ein Reiter weniger koste weniger Sold",
      "note": "Sold statt Aufsicht"
    },
    {
      "device": "aed5d068-088e-4dff-bd26-cf74191359c6",
      "line": 90,
      "range": [0, 77],
      "excerpt": "Von der Turmserie der Bergwacht am Hang steht nur noch einer mit einer Glocke",
      "note": "Nur ein Turm steht noch"
    },
    {
      "device": "5b98a579-d5a4-4362-ab44-635e3b426ca8",
      "line": 90,
      "endLine": 91,
      "range": [79, 25],
      "excerpt": "wann die Glocke\nje ein Feuer gemeldet hat",
      "note": "Glocke warnt nicht"
    },
    {
      "device": "aed5d068-088e-4dff-bd26-cf74191359c6",
      "line": 91,
      "range": [27, 58],
      "excerpt": "weiß in Marderbach niemand mehr"
    },
    {
      "device": "d8935b30-7b92-4aab-877d-7871b59c82a9",
      "line": 91,
      "range": [61, 92],
      "excerpt": "Asche fällt, und niemand löscht",
      "note": "Asche fällt, niemand löscht"
    },
    {
      "device": "cfd87aa7-f33f-46d5-b1bb-c78987b626f4",
      "line": 93,
      "range": [29, 98],
      "excerpt": "lernen die Kinder die Sagen vom guten Drachen und vom bösen Faserwurm",
      "note": "Kinder lernen Sagen"
    },
    {
      "device": "3258a4ae-179b-49f0-a8da-eccbf571d847",
      "line": 94,
      "range": [0, 50],
      "excerpt": "und wer nachzähle, finde mehr Mythen als Messungen",
      "note": "Mythen statt Messungen"
    },
    {
      "device": "5924d9fd-bf89-4494-878f-c337c2dd5c94",
      "line": 94,
      "range": [52, 60],
      "excerpt": "Verklärt"
    },
    {
      "device": "a283b452-67b3-4ebf-944e-ec27129aa801",
      "line": 94,
      "range": [62, 71],
      "excerpt": "glücklich"
    },
    {
      "device": "d043c516-6e42-4940-924a-e2fdca3399f3",
      "line": 94,
      "endLine": 95,
      "range": [73, 31],
      "excerpt": "am Aschmondtag stehen\nsie alle am Feldrain und winken",
      "note": "Kinder winken den Feuerfliegern"
    },
    {
      "device": "5b98a579-d5a4-4362-ab44-635e3b426ca8",
      "line": 97,
      "range": [0, 15],
      "excerpt": "Die Sturmglocke"
    },
    {
      "device": "9861c7d0-d592-4c2a-8e6f-ae8cd4fa854d",
      "line": 97,
      "range": [40, 51],
      "excerpt": "Greifenpass"
    },
    {
      "device": "9713e26c-b966-44ec-ae4f-64a3d8742799",
      "line": 97,
      "range": [58, 81],
      "excerpt": "ein Streifen Regenbogen",
      "note": "Regenbogen über dem Pass"
    },
    {
      "device": "a0b84152-0abf-4c4e-ab04-d34437d3178c",
      "line": 98,
      "range": [24, 70],
      "excerpt": "nicht von Drachenfeuer, sondern von Runenfaser"
    },
    {
      "device": "1a30cd7b-a85e-4099-ab12-efb077b419ec",
      "line": 98,
      "endLine": 99,
      "range": [72, 16],
      "excerpt": "gewirkt von Runenwirten\naus dem Tiefland",
      "note": "Runenwirte wirken"
    },
    {
      "device": "5924d9fd-bf89-4494-878f-c337c2dd5c94",
      "line": 99,
      "range": [18, 37],
      "excerpt": "ein verklärtes Band"
    },
    {
      "device": "bc147aba-0b4e-42fd-9066-23e920985f43",
      "line": 99,
      "range": [47, 59],
      "excerpt": "Aschefeldern"
    },
    {
      "device": "c4d775f1-71e0-4f7d-9ebd-3b25003521b1",
      "line": 99,
      "range": [61, 81],
      "excerpt": "Der Regenbogen kommt"
    },
    {
      "device": "a283b452-67b3-4ebf-944e-ec27129aa801",
      "line": 99,
      "range": [83, 91],
      "excerpt": "heißt es"
    },
    {
      "device": "642f9b91-cbf1-40f8-b672-c8c5c89d7187",
      "line": 100,
      "range": [0, 39],
      "excerpt": "bis dahin fliegen die Feuerflieger tief"
    },
    {
      "device": "d8935b30-7b92-4aab-877d-7871b59c82a9",
      "line": 100,
      "range": [41, 66],
      "excerpt": "und die Höfe zählen Asche",
      "note": "Die Höfe zählen Asche"
    }
  ]
}
